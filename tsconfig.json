{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "jsx": "react-jsx", "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["node"], "resolveJsonModule": true
  },
  "include": ["src", "tests", "tsup.config.ts", "playwright.config.ts"]
}
