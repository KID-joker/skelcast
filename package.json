{
  "name": "skelcast",
  "version": "0.1.0",
  "description": "SkelCast — source-to-skeleton tooling for AI coding, React and Vue",
  "repository": { "type": "git", "url": "git+https://github.com/KID-joker/skelcast.git" },
  "homepage": "https://github.com/KID-joker/skelcast#readme",
  "bugs": { "url": "https://github.com/KID-joker/skelcast/issues" },
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "files": [
    "dist",
    "skills"
  ],
  "bin": {
    "skelcast": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/adapters/react.js"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/adapters/vue.js"
    },
    "./client": "./dist/client.js",
    "./virtual": { "types": "./dist/virtual.d.ts" }
  },
  "scripts": {
    "build": "tsup && node scripts/finalize-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "sync": "node dist/cli.js sync --root examples/react && node dist/cli.js sync --root examples/vue",
    "check": "node dist/cli.js check --root examples/react && node dist/cli.js check --root examples/vue",
    "dev": "pnpm run dev:react",
    "dev:react": "vite --config examples/react/vite.config.ts",
    "dev:vue": "vite --config examples/vue/vite.config.ts",
    "build:examples": "vite build --config examples/react/vite.config.ts && vite build --config examples/vue/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=6",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@unocss/core": "66.13.0",
    "@unocss/preset-attributify": "66.13.0",
    "@unocss/preset-mini": "66.13.0",
    "less": "4.9.1",
    "@babel/parser": "^7.29.15",
    "@babel/types": "^7.29.15",
    "@vue/compiler-dom": "^3.5.46",
    "@vue/compiler-sfc": "^3.5.46",
    "postcss": "^8.5.33",
    "postcss-import": "^17.0.1",
    "postcss-modules": "^9.1.3",
    "postcss-selector-parser": "7.2.1"
  },
  "devDependencies": {
    "@types/less": "3.0.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/postcss-import": "^14.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.46"
  }
}
